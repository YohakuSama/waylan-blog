# Local Worker only. Never commit .dev.vars. Production: npx wrangler secret put KEY
SITE_ORIGIN=http://localhost:8787
GITHUB_REPO_OWNER=YOUR_GITHUB_USERNAME
GITHUB_REPO_NAME=YOUR_PUBLIC_DISCUSSIONS_REPOSITORY
# The login provider must be explicit; do not fall back to a legacy OAuth App.
GITHUB_AUTH_PROVIDER=github-app
GITHUB_APP_CLIENT_ID=YOUR_DEV_GITHUB_APP_CLIENT_ID
GITHUB_APP_CLIENT_SECRET=YOUR_DEV_GITHUB_APP_CLIENT_SECRET
# Fine-grained PAT: selected PUBLIC repository, Discussions: read-only, Metadata: read
GITHUB_READ_TOKEN=YOUR_READ_ONLY_TOKEN
# Generate: openssl rand -base64 32
SESSION_SECRET=YOUR_RANDOM_32_BYTE_SECRET
# Optional GitHub webhook secret
GITHUB_WEBHOOK_SECRET=YOUR_RANDOM_WEBHOOK_SECRET
